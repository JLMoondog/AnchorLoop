rem --------------------------------
rem Mini Jam 200: Freedom
rem Game Entry: Anchor Loop
rem JLMoondog - Josh Mooney
rem --------------------------------

rem setup screen -------------------
set window on : set window layout 1, 1, 1
set display mode 1024, 768, 32
windowTitle$ = "MJ200: Anchor Loop"
set window title windowTitle$

autocam off : `hide mouse
sync on : sync rate 60

rem declare variables --------------
`system var
DEBUG = 1 : `debug on / off

`character stats
playerSize# = 10.0 : `base stats
playerSpeed# = 1.0
playerTurnSpeed# = 6.0
playerAngle# = 0.0
playerHeight# = playerSize# / 2

`character stamina / steps
steps = 100 : `remaining steps
stepsMax = 100 : `max steps for reset
stamina = 120 : `current stamina drain
staminaMax = 120 : `max stamina to restart stamina
moving = 0 : `check if character is moving
deaths = 0 : `count number of deaths

`landmark stats (divide original coor's by 2 * 100 to fit within DB limits)
spawnX# = 1900.0 : `spawn point
spawnY# = 0.0
spawnZ# = 450.0

anchorX# = 3120 : `anchor point
anchorY# = 50
anchorZ# = 3240

rem initiate -----------------------
`_INITIATE:
`setup enviroment
fogDistance# = 800
fog on : fog color rgb(255, 255, 255)
fog distance fogDistance#
backdrop on : color backdrop rgb(255, 255, 255)
set camera range 1, 10000
cls

`create temp player
make object cube 1, playerSize#
color object 1, rgb(0, 200, 0)
set object collision on 1
position object 1, spawnX#, spawnY#+playerHeight#, spawnZ#
rotate object 1, object angle x(1), playerAngle#, object angle z(1)

`create matrix
mapWidth = 64
mapHeight = 64
tileSize# = 100

mapSizeX# = mapWidth * tileSize#
mapSizeZ# = mapHeight * tileSize#
mapGridX# = mapWidth
mapGridZ# = mapHeight

`matrix hieghtmap load

dim heightMap(64,64)
dataSize = 64*64
dim mapData(dataSize)
saveData = 0

if file exist("media/mapdata.map")=0
   load bitmap "media/heightmap.bmp", 1
   for hx = 1 to 64 : `grab height info
      for hy = 1 to 64
         rawValue = point(hx,hy)
         heightMap(hx,hy) = rgbr(rawValue)
      next hy
   next hx
   for smx = 1 to 64
      for smy = 1 to 64
         inc saveData, 1
         mapData(saveData) = heightMap(smx,smy)
      next smy
   next smx
   save array "media/mapdata.map", mapData(dataSize)
   delete bitmap 1
else
   load array "media/mapdata.map", mapData(dataSize)
   for smx = 1 to 64
      for smy = 1 to 64
         inc saveData, 1
         heightMap(smx,smy) = mapData(saveData)
      next smy
   next smx
endif

`build matrix
make matrix 1, mapSizeX#, mapSizeZ#, mapGridX#, mapGridZ#
position matrix 1, 0, 0, 0

`set matrix height
for x = 0 to mapWidth
   for z = 0 to mapHeight
       set matrix height 1, x, z, heightMap(x,z)
   next z
next x

`textureing terrain
load image "media/maptexture.bmp", 10
prepare matrix texture 1, 10, 2, 2
set matrix 1, 1, 1, 1, 1, 1, 1, 1
`set texture based on height
for tx = 0 to 63
   for ty = 0 to 63
      tileHeight = heightMap(tx+1,ty+1)
      if tileHeight < 20 then tileSelect = 4
      if tileHeight > 19 and tileHeight < 65 then tileSelect = 2
      if tileHeight > 64 and tileHeight < 130 then tileSelect = 1
      if tileHeight > 129 then tileSelect = 3
      set matrix tile 1, tx, ty, tileSelect
   next ty
next tx
update matrix 1

`create/load location objects
`create anchor
make object box 2, 100, 1000, 100
color object 2, rgb(64,64,255)
set object collision on 2
anchorY# = get ground height( 1, anchorX#, anchorZ#)+450
position object 2, anchorX#, anchorY#, anchorZ#

rem main game loop -----------------
do
rem debug ui -----------------------
if DEBUG = 1
   ink rgb(0,0,0),rgb(255,255,255)
   set cursor 0, 0
   print "  DEBUG ACTIVE"
   print "  Player X: ";object position x(1)
   print "  Player Y: ";object position y(1)
   print "  Player Z: ";object position z(1)
   print "  Player A: ";object angle y(1)
   print "  IsMoving: ";moving
   print "  Steps Left: ";steps
   print "  Stamina: ";stamina
   print "  Deaths: ";deaths
endif

rem player controls ----------------
moving = 0 : `reset moving check
if upkey() = 1
   move object 1, playerSpeed#
   moving = 1
endif
if downkey() = 1
   move object 1, 0-playerSpeed#
   moving = 1
endif
if rightkey() = 1
   playerAngle# = wrapvalue(playerAngle#+playerTurnSpeed#)
   moving = 1
endif
if leftkey() = 1
   playerAngle# = wrapvalue(playerAngle#-playerTurnSpeed#)
   moving = 1
endif
` steps and stamina --------------
if moving = 1 : `check if moving
   dec stamina, 1
   if stamina = 0 : `if stamina is 0, use step
      dec steps
      stamina = staminaMax
   endif
endif
` death and respawn
if steps = 0
   steps = stepsMax
   inc deaths, 1
   position object 1, spawnX#, spawnY#+playerHeight#, spawnZ#
   rotate object 1, object angle x(1), 0.0, object angle z(1)
endif

rem update -------------------------
`_UPDATE:
`player update
rotate object 1, object angle x(1), playerAngle#, object angle z(1)
playerHeight# = get ground height(1, object position x(1), object position z(1)) + (playerSize#/2)
position object 1, object position x(1), playerHeight#, object position z(1)
`camera update
set camera to follow object position x(1), object position y(1), object position z(1), 0.0, 90.0, playerHeight#+100.0, 50.0, 0
point camera object position x(1), playerHeight#, object position z(1)

rem reset --------------------------
`_RESET:

rem end ----------------------------
`_END:

rem end loop -----------------------
   sync
loop

