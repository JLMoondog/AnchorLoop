rem setup screen -------------------
set window on : set window layout 1, 1, 1
set display mode 1024, 768, 32
windowTitle$ = "MJ200: Anchor Loop"
set window title windowTitle$

autocam off : hide mouse
sync on : sync rate 60

rem declare variables --------------
`system var
DEBUG = 1 : `debug on / off
`character stats
playerSize# = 10.0 : `base stats
playerSpeed# = 1.0
playerTurnSpeed# = 6.0
`landmark stats
spawnX# = 385.0
spawnY# = playerSize#/2
spawnZ# = 995.0

rem initiate -----------------------
_INITIATE:
`create temp player
make object cube 1, playerSize#
color object 1, rgb(0, 200, 0)
set object collision on 1
position object 1, spawnX#, spawnY#, spawnZ#


rem main game loop -----------------
do
rem debug ui -----------------------
if DEBUG = 1
endif

rem update -------------------------
_UPDATE:

rem reset --------------------------
_RESET:

rem end ----------------------------
_END:

rem end loop -----------------------
   sync
loop
